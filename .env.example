# Copy to .env and fill in what you have. Every key is OPTIONAL:
# with no keys the app runs fully locally (Sketch-CAD + TripoSR + offline inflation).

# Hugging Face token (free: https://huggingface.co/settings/tokens, "Read" scope).
# Unlocks the TRELLIS (3D) and FLUX.1 Kontext (sketch->image) ZeroGPU Spaces.
# Free accounts get only a few GPU-minutes/day (one full run uses ~150 s); PRO gets 25 min/day.
# You can list several tokens (e.g. one per teammate), comma-separated: they rotate on quota errors.
HF_TOKEN=

# Google AI Studio key (free tier: https://aistudio.google.com/apikey).
# Sketch-to-image with Gemini's image model + auto-captioning.
GEMINI_API_KEY=

# Replicate token (paid, pay-per-run: https://replicate.com/account/api-tokens).
# ControlNet scribble + TRELLIS without HF queues.
REPLICATE_API_TOKEN=

# Optional overrides
# IMAGE_PROVIDERS=kontext_space,gemini,replicate,hf,local
# MESH_PROVIDERS=trellis,triposr_local,replicate_trellis,local
# NUM_CANDIDATES=2
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional: write outputs outside OneDrive (sync clients can lock new files)
# OUTPUT_DIR=C:/sketch2shape_outputs

# DEVICE=auto            # auto | cuda | cpu. With CUDA: SD1.5 + ControlNet (batched candidates) + TripoSR on GPU
# SD_STEPS=20            # ControlNet sampling steps (GPU)
